@{
}
@model Student_Management_System.Models.Student;
<h2>Edit Student</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" name="StudentId" value="@Model.StudentId" />
    <table>
        <tr>
            <td>Name</td>
            <td><input type="text" name="Name" value="@Model.Name" /></td>
        </tr>
        <tr>
            <td>Email</td>
            <td><input type="text" name="Email" value="@Model.Email" /></td>
        </tr>
        <tr>
            <td>Age</td>
            <td><input type="text" name="Age" value="@Model.Age" /></td>
        </tr>
        <tr>
            <td>Gender</td>
            <td>
                <input type="radio" name="Gender" value="Male" @(Model.Gender == "Male" ? "checked" : "") /> Male
                <input type="radio" name="Gender" value="Female" @(Model.Gender == "Female" ? "checked" : "") /> Female
            </td>
        </tr>
        <tr>
            <td><input type="submit" value="Save" /></td>
        </tr>
    </table>
</form>