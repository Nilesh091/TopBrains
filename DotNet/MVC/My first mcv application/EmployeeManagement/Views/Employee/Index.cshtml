@model IEnumerable<Employee>
<table class="table table-dark" border="1">
    <th>Id</th>
    <th>Name</th>
    <th>Department</th>

    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Id</td>
            <td>@v.Name</td>
            <td>@v.Department</td>
        </tr>

    }
</table>