@model Book

<h2>Add New Book</h2>

<form asp-action="Create" method="post">

    <label>Book Id</label>
    <input asp-for="BookId" />
    <br /><br />

    <label>Title</label>
    <input asp-for="Title" />
    <br /><br />

    <label>Author</label>
    <input asp-for="Author" />
    <br /><br />

    <label>Price</label>
    <input asp-for="Price" />
    <br /><br />

    <button type="submit">Add Book</button>

</form>

<br>

<a asp-action="List">Back</a>