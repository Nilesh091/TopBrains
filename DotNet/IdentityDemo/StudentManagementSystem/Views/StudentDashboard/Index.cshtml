@model StudentManagementSystem.Models.Student

<h2>Student Dashboard</h2>

<table class="table table-bordered">

    <tr>
        <td>Name</td>
        <td>@Model.StudentName</td>
    </tr>

    <tr>
        <td>Email</td>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <td>Phone</td>
        <td>@Model.PhoneNumber</td>
    </tr>

    <tr>
        <td>Address</td>
        <td>@Model.Address</td>
    </tr>

    <tr>
        <td>Department</td>
        <td>@Model.Department.DepartmentName</td>
    </tr>

    <tr>
        <td>Course</td>
        <td>@Model.Course.CourseName</td>
    </tr>

    <tr>
        <td>Duration</td>
        <td>@Model.Course.Duration</td>
    </tr>

    <tr>
        <td>Fees</td>
        <td>@Model.Course.Fees</td>
    </tr>

</table>

<a asp-action="EditProfile" class="btn btn-primary">
    Update Profile
</a>