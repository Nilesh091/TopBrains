@model IEnumerable<StudentManagementSystem.Models.Student>

<h2>Students List</h2>

<a asp-action="CreateStudent" class="btn btn-success mb-3">
    Add Student
</a>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Course</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.Email</td>
                <td>@s.Department.DepartmentName</td>
                <td>@s.Course.CourseName</td>

                <td>
                    <a asp-action="EditStudent" asp-route-id="@s.StudentId" class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="DeleteStudent" asp-route-id="@s.StudentId" class="btn btn-danger"
                           onclick="return confirm('Delete this student?')">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>