con","id":"Ocelot","language":"","licenseExpression":"","licenseUrl":"","listed":true,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/19.0.4/ocelot.19.0.4.nupkg","projectUrl":"https://github.com/ThreeMammals/Ocelot","published":"2023-10-06T11:15:46.497+00:00","requireLicenseAcceptance":false,"summary":"","tags":["API","Gateway",".NET","core"],"title":"","version":"19.0.4"},"packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/19.0.4/ocelot.19.0.4.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/20.0.0.json","@type":"Package","commitId":"02585dde-d05c-4c6f-bb49-2233ed1a4749","commitTimeStamp":"2023-10-07T08:18:18.3892727+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2023.10.07.08.17.26/ocelot.20.0.0.json","@type":"PackageDetails","authors":"Tom Pallister","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2023.10.07.08.17.26/ocelot.20.0.0.json#dependencygroup/net7.0","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2023.10.07.08.17.26/ocelot.20.0.0.json#dependencygroup/net7.0/fluentvalidation","@type":"PackageDependency","id":"FluentValidation","range":"[11.5.2, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/fluentvalidation/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2023.10.07.08.17.26/ocelot.20.0.0.json#dependencygroup/net7.0/ipaddressrange","@type":"PackageDependency","id":"IPAddressRange","range":"[6.0.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ipaddressrange/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2023.10.07.08.17.26/ocelot.20.0.0.json#dependencygroup/net7.0/microsoft.aspnetcore.middlewareanalysis","@type":"PackageDependency","id":"Microsoft.AspNetCore.MiddlewareAnalysis","range":"[7.0.5, )","registration":"https://api.nuget.org/v3/regis