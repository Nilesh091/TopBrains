 pipeline. It does not call the next middleware. The response from the downstream service is stored in a per request scoped repository and retrived as the requests goes back up the Ocelot pipeline. There is a piece of middleware that maps the HttpResponseMessage onto the HttpResponse object and that is returned to the client. That is basically it with a bunch of other features.","iconUrl":"","id":"Ocelot","language":"","licenseExpression":"","licenseUrl":"","listed":false,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0039/ocelot.1.5.0-unstable0039.nupkg","projectUrl":"https://github.com/TomPallister/Ocelot","published":"1900-01-01T00:00:00+00:00","requireLicenseAcceptance":false,"summary":"","tags":["API","Gateway",".NET","core"],"title":"","version":"1.5.0-unstable0039"},"packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0039/ocelot.1.5.0-unstable0039.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/1.5.0-unstable0043.json","@type":"Package","commitId":"1c6af9d9-c96f-4364-9b88-3355a52de17d","commitTimeStamp":"2024-06-13T08:44:03.1748206+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.42.48/ocelot.1.5.0-unstable0043.json","@type":"PackageDetails","authors":"Tom Pallister","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.42.48/ocelot.1.5.0-unstable0043.json#dependencygroup/.netcoreapp1.1","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.42.48/ocelot.1.5.0-unstable0043.json#dependencygroup/.netcoreapp1.1/microsoft.netcore.app","@type":"PackageDependency","id":"Microsoft.NETCore.App","range":"[1.1.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.netcore.app/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.