om the downstream service is stored in a per request scoped repository and retrived as the requests goes back up the Ocelot pipeline. There is a piece of middleware that maps the HttpResponseMessage onto the HttpResponse object and that is returned to the client. That is basically it with a bunch of other features.","iconUrl":"","id":"Ocelot","language":"","licenseExpression":"","licenseUrl":"","listed":false,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0043/ocelot.1.5.0-unstable0043.nupkg","projectUrl":"https://github.com/TomPallister/Ocelot","published":"1900-01-01T00:00:00+00:00","requireLicenseAcceptance":false,"summary":"","tags":["API","Gateway",".NET","core"],"title":"","version":"1.5.0-unstable0043"},"packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0043/ocelot.1.5.0-unstable0043.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/1.5.0-unstable0053.json","@type":"Package","commitId":"10589421-8efd-4a55-86c7-e6ceb5864291","commitTimeStamp":"2024-06-12T12:38:46.5485588+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.12.12.38.08/ocelot.1.5.0-unstable0053.json","@type":"PackageDetails","authors":"Tom Pallister","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.12.12.38.08/ocelot.1.5.0-unstable0053.json#dependencygroup/.netcoreapp1.1","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.12.12.38.08/ocelot.1.5.0-unstable0053.json#dependencygroup/.netcoreapp1.1/microsoft.netcore.app","@type":"PackageDependency","id":"Microsoft.NETCore.App","range":"[1.1.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.netcore.app/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.12.12.38.08/ocelot.1.5.0-unstable0053.json#dependencygroup/.netc