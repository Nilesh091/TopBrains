dency","id":"Microsoft.AspNetCore.Mvc","range":"[1.1.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.aspnetcore.mvc/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/microsoft.aspnetcore.server.kestrel","@type":"PackageDependency","id":"Microsoft.AspNetCore.Server.Kestrel","range":"[1.1.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.aspnetcore.server.kestrel/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/microsoft.netcore.app","@type":"PackageDependency","id":"Microsoft.NETCore.App","range":"[1.1.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.netcore.app/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/cachemanager.core","@type":"PackageDependency","id":"CacheManager.Core","range":"[0.9.2, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/cachemanager.core/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/cachemanager.microsoft.extensions.configuration","@type":"PackageDependency","id":"CacheManager.Microsoft.Extensions.Configuration","range":"[0.9.2, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/cachemanager.microsoft.extensions.configuration/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/cachemanager.microsoft.extensions.logging","@type":"PackageDependency","id":"CacheManager.Microsoft.Extensions.Logging","range":"[0.9.2, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/cachemanager.microsoft.extensions.logging/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/consul","@type":"PackageDependency","id":"Consul","range":"[0.7.2.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/consul/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/polly","@type":"PackageDependency","id":"Polly","range":"[5.0.3, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/polly/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/identityserver4","@type":"PackageDependency","id":"IdentityServer4","range":"[1.0.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/identityserver4/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#dependencygroup/.netcoreapp1.1/microsoft.aspnetcore.cryptography.keyderivation","@type":"PackageDependency","id":"Microsoft.AspNetCore.Cryptography.KeyDerivation","range":"[1.1.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.aspnetcore.cryptography.keyderivation/index.json"}],"targetFramework":".NETCoreApp1.1"}],"deprecation":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.44.10/ocelot.1.5.0-unstable0004.json#deprecation","@type":"deprecation","reasons":["Legacy","CriticalBugs"]},"description":"This project is aimed at people using .NET running a micro services / service orientated architecture that need a unified point of entry into their system. In particular I want easy integration with IdentityServer reference and bearer tokens. We have been unable to find this in my current workplace without having to write our own Javascript middlewares to handle the IdentityServer reference tokens. We would rather use the IdentityServer code that already exists to do this. Ocelot is a bunch of middlewares in a specific order. Ocelot manipulates the HttpRequest object into a state specified by its configuration until it reaches a request builder middleware where it creates a HttpRequestMessage object which is used to make a request to a downstream service. The middleware that makes the request is the last thing in the Ocelot pipeline. It does not call the next middleware. The response from the downstream service is stored in a per request scoped repository and retrived as the requests goes back up the Ocelot pipeline. There is a piece of middleware that maps the HttpResponseMessage onto the HttpResponse object and that is returned to the client. That is basically it with a bunch of other features.","iconUrl":"","id":"Ocelot","language":"","licenseExpression":"","licenseUrl":"","listed":false,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0004/ocelot.1.5.0-unstable0004.nupkg","projectUrl":"https://github.com/TomPallister/Ocelot","published":"1900-01-01T00:00:00+00:00","requireLicenseAcceptance":false,"summary":"API Gateway created using .NET core.","tags":["API","Gateway",".NET","core"],"title":"Ocelot","version":"1.5.0-unstable0004"},"packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.5.0-unstable0004/ocelot.1.5.0-unstable0004.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/1.5.0-unstable0027.json","@type":"Package","commitId":"1c6af9d9-c96f-4364-9b88-3355a52de17d","commitTimeStamp":"2024-06-13T08:44:03.1748206+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.43.36/ocelot.1.5.0-unstable0027.json","@type":"PackageDetails","authors":"Tom Pallister","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.43.36/ocelot.1.5.0-unstable0027.json#dependencygroup/.netcoreapp1.1","@type":"PackageDependencyGroup","dependencies":[{