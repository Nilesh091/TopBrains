service is stored in a per request scoped repository and retrived as the requests goes back up the Ocelot pipeline. There is a piece of middleware that maps the HttpResponseMessage onto the HttpResponse object and that is returned to the client. That is basically it with a bunch of other features.","iconUrl":"","id":"Ocelot","language":"","licenseExpression":"","licenseUrl":"","listed":false,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.4.5/ocelot.1.4.5.nupkg","projectUrl":"https://github.com/TomPallister/Ocelot","published":"1900-01-01T00:00:00+00:00","requireLicenseAcceptance":false,"summary":"","tags":["API","Gateway",".NET","core"],"title":"","version":"1.4.5"},"packageContent":"https://api.nuget.org/v3-flatcontainer/ocelot/1.4.5/ocelot.1.4.5.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/ocelot/1.4.6.json","@type":"Package","commitId":"05bd6a9f-83b5-4e39-8c3f-f2a286d3379a","commitTimeStamp":"2024-06-13T08:46:09.3491167+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.45.18/ocelot.1.4.6.json","@type":"PackageDetails","authors":"Tom Pallister","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.45.18/ocelot.1.4.6.json#dependencygroup/.netcoreapp1.1","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.45.18/ocelot.1.4.6.json#dependencygroup/.netcoreapp1.1/microsoft.netcore.app","@type":"PackageDependency","id":"Microsoft.NETCore.App","range":"[1.1.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.netcore.app/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.06.13.08.45.18/ocelot.1.4.6.json#dependencygroup/.netcoreapp1.1/microsoft.aspnetcore.server.iisintegration","@type":"PackageDependency","id":"Microsoft.AspNetCore.Server.IISIntegration","range":"[1.1.1,