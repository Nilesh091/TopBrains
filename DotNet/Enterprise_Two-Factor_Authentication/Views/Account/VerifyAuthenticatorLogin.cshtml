@model Enterprise_Two_Factor_Authentication.ViewModels.VerifyAuthenticatorViewModel

@{
    ViewData["Title"] = "Two Factor Authentication";
}

<section class="interactive-page py-4">
    <div class="interactive-card p-4 p-md-5 mx-auto" style="max-width: 560px;">
        <h2 class="mb-3">Two-Factor Authentication</h2>

        <p class="mb-4">Please enter the 6-digit code from your authenticator app.</p>

        <form asp-action="VerifyAuthenticatorLogin" method="post" class="interactive-form">
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMachine" class="form-check-input" />
                <label asp-for="RememberMachine" class="form-check-label">Remember this device</label>
            </div>

            <button type="submit" class="interactive-button">Verify</button>
        </form>

        <div asp-validation-summary="All" class="text-danger mt-3"></div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}