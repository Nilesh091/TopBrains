@{
}
<h2>Verify Email OTP</h2>

<form asp-action="VerifyEmailOTP" method="post">

    <input type="hidden" name="email" value="@ViewBag.Email" />

    <div>
        <label>OTP</label>
        <input type="text" name="code" class="form-control" />
    </div>

    <br>

    <button type="submit" class="btn btn-success">
        Verify
    </button>

</form>